{
  "name": "readme-sync",
  "version": "0.1.0",
  "description": "CI plugin that keeps README.md in sync with the codebase by surgically patching tool-owned sections.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "readme-sync": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "build:action": "tsup --config tsup.action.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "schema": "node ./scripts/gen-schema.mjs",
    "readme-sync": "node ./dist/cli/index.js"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "commander": "^13.1.0",
    "diff": "^8.0.2",
    "picomatch": "^4.0.2",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.3.4",
    "typescript": "^5.8.3",
    "unified": "^11.0.5",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/diff": "^8.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.32",
    "@types/picomatch": "^4.0.0",
    "@types/unist": "^3.0.3",
    "eslint": "^9.29.0",
    "fast-check": "^4.1.1",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.24.5"
  },
  "packageManager": "pnpm@11.5.1"
}
